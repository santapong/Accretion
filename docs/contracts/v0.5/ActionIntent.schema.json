{
  "$defs": {
    "ActionConstraints": {
      "additionalProperties": false,
      "properties": {
        "acceleration_scale": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Acceleration Scale",
          "type": "number"
        },
        "planning_time_ms": {
          "exclusiveMinimum": 0,
          "maximum": 60000,
          "title": "Planning Time Ms",
          "type": "integer"
        },
        "speed_scale": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Speed Scale",
          "type": "number"
        }
      },
      "required": [
        "speed_scale",
        "acceleration_scale",
        "planning_time_ms"
      ],
      "title": "ActionConstraints",
      "type": "object"
    },
    "ContentAddressedArtifactRef": {
      "additionalProperties": false,
      "description": "Run-independent blob identity; the URI is derived from its exact digest.\n\nThis does not weaken the existing run/path-based ArtifactRef. The artifact\nstore must enforce retention and byte limits when resolving this reference.",
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[^\\s/]+/[^\\s/]+$",
          "title": "Media Type",
          "type": "string"
        },
        "retention_class": {
          "enum": [
            "RUN",
            "PROJECT",
            "RESEARCH_ARCHIVE"
          ],
          "title": "Retention Class",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://sha256/[0-9a-f]{64}$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "digest",
        "media_type",
        "size_bytes",
        "retention_class",
        "evidence_class"
      ],
      "title": "ContentAddressedArtifactRef",
      "type": "object"
    },
    "EvidenceClass": {
      "description": "How the world was observed. Names are pinned by the v0.4 cross-release registry.",
      "enum": [
        "DIGITAL",
        "SIMULATION",
        "PHYSICAL",
        "HUMAN_ATTESTATION",
        "EXTERNAL_SOURCE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "GripperTarget": {
      "additionalProperties": false,
      "properties": {
        "force_n": {
          "exclusiveMinimum": 0,
          "title": "Force N",
          "type": "number"
        },
        "kind": {
          "const": "SET_GRIPPER",
          "default": "SET_GRIPPER",
          "title": "Kind",
          "type": "string"
        },
        "opening_m": {
          "minimum": 0,
          "title": "Opening M",
          "type": "number"
        }
      },
      "required": [
        "opening_m",
        "force_n"
      ],
      "title": "GripperTarget",
      "type": "object"
    },
    "ObjectiveContractRef": {
      "additionalProperties": false,
      "description": "SDD \u00a77.1. The exact objective revision a node was authorised against.\n\nThis is the type of the registry \u00a73 optional header field ``objective_contract_ref``,\nwhich is why it is defined before every other contract in this module and why\n:class:`~accretion.contracts.canonical.CanonicalContract` is rebuilt immediately below\nit.\n\n**Field coverage (SDD \u00a77.1 \u2192 here).** ``project_id`` \u2192 the header's ``project_id``.\n``objective_contract_id`` \u2192 ``objective_contract_id``. ``version`` \u2192 ``revision``, the\nregistry \u00a77.1 spelling, which is also what the ``ObjectiveContract`` aggregate calls its\nown counter. ``content_hash`` \u2192 ``objective_contract_hash``. ``verified_success_floor``,\n``utility_profile_id``, ``approved_at`` \u2192 unchanged. ``risk_policy_id`` \u2192 ``risk_policy``,\na typed :class:`~accretion.contracts.refs.PolicyRef` (registry \u00a73.1 requires policies to\nuse immutable typed references, and an authority decision audited against \"policy v3\" is\naudited against a label). ``approved_by`` \u2192 a typed\n:class:`~accretion.contracts.PrincipalRef` for the same reason.\n\n**Why the target's identity is qualified.** Registry \u00a73 describes the header field as\n``{contract_id, revision, content_hash}``, but inside a :class:`CanonicalContract` those\ntwo unqualified names already mean *this reference's own* id and digest. The target's\nare therefore spelled ``objective_contract_id`` and ``objective_contract_hash``. Nothing\nis lost and the ambiguity that would otherwise sit in every receipt is.\n\n``ID_KIND`` is ``None``: ADR-055 mints no prefix for a reference, because a reference is\ncreated and owned by the contract that embeds it and has no id space to collide in.\n``verified_success_floor`` is copied onto the reference rather than dereferenced because\n\u00a78.3 requires routing to run against an exact snapshot \u2014 a router that re-read the floor\nfrom the live objective would be routing against a number the receipt cannot prove.",
      "properties": {
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "approved_by": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "content_hash": {
          "default": "",
          "maxLength": 64,
          "title": "Content Hash",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        },
        "contract_type": {
          "const": "accretion.objective-contract-ref",
          "default": "accretion.objective-contract-ref",
          "title": "Contract Type",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "objective_contract_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Objective Contract Hash",
          "type": "string"
        },
        "objective_contract_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Objective Contract Id",
          "type": "string"
        },
        "objective_contract_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectiveContractRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "project_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "retention_class": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retention Class"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "risk_policy": {
          "$ref": "#/$defs/PolicyRef"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "supersedes_contract_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Contract Id"
        },
        "utility_profile_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Utility Profile Id",
          "type": "string"
        },
        "verified_success_floor": {
          "maximum": 1,
          "minimum": 0,
          "title": "Verified Success Floor",
          "type": "number"
        },
        "workspace_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "created_by",
        "workspace_id",
        "objective_contract_id",
        "revision",
        "objective_contract_hash",
        "verified_success_floor",
        "utility_profile_id",
        "risk_policy",
        "approved_by",
        "approved_at"
      ],
      "title": "ObjectiveContractRef",
      "type": "object"
    },
    "PolicyRef": {
      "additionalProperties": false,
      "description": "A policy by id, version and content digest (registry \u00a74).\n\nAuthority decisions are audited against the exact policy text that produced them, so the\ncontent digest is required: \"policy v3\" is a label, and labels are editable.",
      "properties": {
        "content_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "policy_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "version",
        "content_digest"
      ],
      "title": "PolicyRef",
      "type": "object"
    },
    "PoseTarget": {
      "additionalProperties": false,
      "properties": {
        "frame_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s*]+$",
          "title": "Frame Id",
          "type": "string"
        },
        "kind": {
          "const": "MOVE_END_EFFECTOR",
          "default": "MOVE_END_EFFECTOR",
          "title": "Kind",
          "type": "string"
        },
        "orientation_xyzw": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Orientation Xyzw",
          "type": "array"
        },
        "position_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position M",
          "type": "array"
        }
      },
      "required": [
        "frame_id",
        "position_m",
        "orientation_xyzw"
      ],
      "title": "PoseTarget",
      "type": "object"
    },
    "PrincipalRef": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "principal_id": {
          "title": "Principal Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PrincipalStatus"
        }
      },
      "required": [
        "principal_id",
        "status"
      ],
      "title": "PrincipalRef",
      "type": "object"
    },
    "PrincipalStatus": {
      "enum": [
        "ACTIVE",
        "DISABLED"
      ],
      "title": "PrincipalStatus",
      "type": "string"
    },
    "SemanticAction": {
      "enum": [
        "MOVE_END_EFFECTOR",
        "JOINT_TRAJECTORY",
        "SET_GRIPPER"
      ],
      "title": "SemanticAction",
      "type": "string"
    },
    "StateBinding": {
      "additionalProperties": false,
      "properties": {
        "frame_transform_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Frame Transform Digest",
          "type": "string"
        },
        "observation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Digest",
          "type": "string"
        },
        "observation_sequence": {
          "minimum": 0,
          "title": "Observation Sequence",
          "type": "integer"
        },
        "sim_time_ns": {
          "minimum": 0,
          "title": "Sim Time Ns",
          "type": "integer"
        }
      },
      "required": [
        "observation_digest",
        "observation_sequence",
        "sim_time_ns",
        "frame_transform_digest"
      ],
      "title": "StateBinding",
      "type": "object"
    },
    "TrajectoryTarget": {
      "additionalProperties": false,
      "properties": {
        "frame_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\s*]+$",
          "title": "Frame Id",
          "type": "string"
        },
        "joint_names": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[^\\s*]+$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Joint Names",
          "type": "array"
        },
        "kind": {
          "const": "JOINT_TRAJECTORY",
          "default": "JOINT_TRAJECTORY",
          "title": "Kind",
          "type": "string"
        },
        "trajectory_ref": {
          "$ref": "#/$defs/ContentAddressedArtifactRef"
        }
      },
      "required": [
        "frame_id",
        "trajectory_ref",
        "joint_names"
      ],
      "title": "TrajectoryTarget",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "constraints": {
      "$ref": "#/$defs/ActionConstraints"
    },
    "content_hash": {
      "default": "",
      "maxLength": 64,
      "title": "Content Hash",
      "type": "string"
    },
    "contract_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Contract Id",
      "type": "string"
    },
    "contract_type": {
      "const": "accretion.action-intent",
      "default": "accretion.action-intent",
      "title": "Contract Type",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/PrincipalRef"
    },
    "episode_id": {
      "pattern": "^sep_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Episode Id",
      "type": "string"
    },
    "expires_at_sim_time_ns": {
      "minimum": 0,
      "title": "Expires At Sim Time Ns",
      "type": "integer"
    },
    "idempotency_key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Labels",
      "type": "object"
    },
    "objective_contract_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectiveContractRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "project_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "retention_class": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retention Class"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_action": {
      "$ref": "#/$defs/SemanticAction"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/StateBinding"
    },
    "supersedes_contract_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Contract Id"
    },
    "target": {
      "discriminator": {
        "mapping": {
          "JOINT_TRAJECTORY": "#/$defs/TrajectoryTarget",
          "MOVE_END_EFFECTOR": "#/$defs/PoseTarget",
          "SET_GRIPPER": "#/$defs/GripperTarget"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PoseTarget"
        },
        {
          "$ref": "#/$defs/TrajectoryTarget"
        },
        {
          "$ref": "#/$defs/GripperTarget"
        }
      ],
      "title": "Target"
    },
    "workspace_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "created_by",
    "workspace_id",
    "episode_id",
    "sequence",
    "semantic_action",
    "target",
    "constraints",
    "state",
    "expires_at_sim_time_ns",
    "idempotency_key"
  ],
  "title": "ActionIntent",
  "type": "object"
}
