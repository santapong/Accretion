{
  "$defs": {
    "ContentAddressedArtifactRef": {
      "additionalProperties": false,
      "description": "Run-independent blob identity; the URI is derived from its exact digest.\n\nThis does not weaken the existing run/path-based ArtifactRef. The artifact\nstore must enforce retention and byte limits when resolving this reference.",
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[^\\s/]+/[^\\s/]+$",
          "title": "Media Type",
          "type": "string"
        },
        "retention_class": {
          "enum": [
            "RUN",
            "PROJECT",
            "RESEARCH_ARCHIVE"
          ],
          "title": "Retention Class",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://sha256/[0-9a-f]{64}$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "digest",
        "media_type",
        "size_bytes",
        "retention_class",
        "evidence_class"
      ],
      "title": "ContentAddressedArtifactRef",
      "type": "object"
    },
    "EvidenceClass": {
      "description": "How the world was observed. Names are pinned by the v0.4 cross-release registry.",
      "enum": [
        "DIGITAL",
        "SIMULATION",
        "PHYSICAL",
        "HUMAN_ATTESTATION",
        "EXTERNAL_SOURCE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "NodeContractRef": {
      "additionalProperties": false,
      "description": "The exact node contract a routing context was built from (SDD \u00a77.4, \u00a78.3).\n\nSDD \u00a77.4 writes ``node_contract_ref: uuid``. An id alone would not satisfy \u00a78.3, which\nrequires routing to use an *exact snapshot*: the id would still resolve after a\nrevision, and the decision would silently claim to have been made against a contract it\nnever saw. Pinning ``immutable_hash`` is what makes the claim checkable.",
      "properties": {
        "immutable_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Immutable Hash",
          "type": "string"
        },
        "node_contract_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Node Contract Id",
          "type": "string"
        }
      },
      "required": [
        "node_contract_id",
        "immutable_hash"
      ],
      "title": "NodeContractRef",
      "type": "object"
    },
    "ObjectiveContractRef": {
      "additionalProperties": false,
      "description": "SDD \u00a77.1. The exact objective revision a node was authorised against.\n\nThis is the type of the registry \u00a73 optional header field ``objective_contract_ref``,\nwhich is why it is defined before every other contract in this module and why\n:class:`~accretion.contracts.canonical.CanonicalContract` is rebuilt immediately below\nit.\n\n**Field coverage (SDD \u00a77.1 \u2192 here).** ``project_id`` \u2192 the header's ``project_id``.\n``objective_contract_id`` \u2192 ``objective_contract_id``. ``version`` \u2192 ``revision``, the\nregistry \u00a77.1 spelling, which is also what the ``ObjectiveContract`` aggregate calls its\nown counter. ``content_hash`` \u2192 ``objective_contract_hash``. ``verified_success_floor``,\n``utility_profile_id``, ``approved_at`` \u2192 unchanged. ``risk_policy_id`` \u2192 ``risk_policy``,\na typed :class:`~accretion.contracts.refs.PolicyRef` (registry \u00a73.1 requires policies to\nuse immutable typed references, and an authority decision audited against \"policy v3\" is\naudited against a label). ``approved_by`` \u2192 a typed\n:class:`~accretion.contracts.PrincipalRef` for the same reason.\n\n**Why the target's identity is qualified.** Registry \u00a73 describes the header field as\n``{contract_id, revision, content_hash}``, but inside a :class:`CanonicalContract` those\ntwo unqualified names already mean *this reference's own* id and digest. The target's\nare therefore spelled ``objective_contract_id`` and ``objective_contract_hash``. Nothing\nis lost and the ambiguity that would otherwise sit in every receipt is.\n\n``ID_KIND`` is ``None``: ADR-055 mints no prefix for a reference, because a reference is\ncreated and owned by the contract that embeds it and has no id space to collide in.\n``verified_success_floor`` is copied onto the reference rather than dereferenced because\n\u00a78.3 requires routing to run against an exact snapshot \u2014 a router that re-read the floor\nfrom the live objective would be routing against a number the receipt cannot prove.",
      "properties": {
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "approved_by": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "content_hash": {
          "default": "",
          "maxLength": 64,
          "title": "Content Hash",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        },
        "contract_type": {
          "const": "accretion.objective-contract-ref",
          "default": "accretion.objective-contract-ref",
          "title": "Contract Type",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "objective_contract_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Objective Contract Hash",
          "type": "string"
        },
        "objective_contract_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Objective Contract Id",
          "type": "string"
        },
        "objective_contract_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectiveContractRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "project_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "retention_class": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retention Class"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "risk_policy": {
          "$ref": "#/$defs/PolicyRef"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "supersedes_contract_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Contract Id"
        },
        "utility_profile_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Utility Profile Id",
          "type": "string"
        },
        "verified_success_floor": {
          "maximum": 1,
          "minimum": 0,
          "title": "Verified Success Floor",
          "type": "number"
        },
        "workspace_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "created_by",
        "workspace_id",
        "objective_contract_id",
        "revision",
        "objective_contract_hash",
        "verified_success_floor",
        "utility_profile_id",
        "risk_policy",
        "approved_by",
        "approved_at"
      ],
      "title": "ObjectiveContractRef",
      "type": "object"
    },
    "PolicyRef": {
      "additionalProperties": false,
      "description": "A policy by id, version and content digest (registry \u00a74).\n\nAuthority decisions are audited against the exact policy text that produced them, so the\ncontent digest is required: \"policy v3\" is a label, and labels are editable.",
      "properties": {
        "content_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "policy_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "version",
        "content_digest"
      ],
      "title": "PolicyRef",
      "type": "object"
    },
    "PrincipalRef": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "principal_id": {
          "title": "Principal Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PrincipalStatus"
        }
      },
      "required": [
        "principal_id",
        "status"
      ],
      "title": "PrincipalRef",
      "type": "object"
    },
    "PrincipalStatus": {
      "enum": [
        "ACTIVE",
        "DISABLED"
      ],
      "title": "PrincipalStatus",
      "type": "string"
    },
    "ReplayClass": {
      "enum": [
        "EXACT",
        "TOLERANT",
        "STATISTICAL"
      ],
      "title": "ReplayClass",
      "type": "string"
    },
    "ResourceBudget": {
      "additionalProperties": false,
      "properties": {
        "max_artifact_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Artifact Bytes",
          "type": "integer"
        },
        "max_episodes": {
          "exclusiveMinimum": 0,
          "title": "Max Episodes",
          "type": "integer"
        },
        "max_wall_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Wall Seconds",
          "type": "number"
        }
      },
      "required": [
        "max_episodes",
        "max_wall_seconds",
        "max_artifact_bytes"
      ],
      "title": "ResourceBudget",
      "type": "object"
    },
    "RoboticsContractRef": {
      "additionalProperties": false,
      "description": "Exact persisted robotics record; not a mutable logical alias.",
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "contract_id": {
          "pattern": "^[a-z]{3}_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Contract Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "content_hash"
      ],
      "title": "RoboticsContractRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_ref": {
      "$ref": "#/$defs/RoboticsContractRef"
    },
    "content_hash": {
      "default": "",
      "maxLength": 64,
      "title": "Content Hash",
      "type": "string"
    },
    "contract_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Contract Id",
      "type": "string"
    },
    "contract_type": {
      "const": "accretion.simulation-experiment",
      "default": "accretion.simulation-experiment",
      "title": "Contract Type",
      "type": "string"
    },
    "controller_artifact_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Controller Artifact Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/PrincipalRef"
    },
    "embodiment_ref": {
      "$ref": "#/$defs/RoboticsContractRef"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Labels",
      "type": "object"
    },
    "node_contract_ref": {
      "$ref": "#/$defs/NodeContractRef"
    },
    "objective_contract_ref": {
      "$ref": "#/$defs/ObjectiveContractRef"
    },
    "project_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "protocol_ref": {
      "$ref": "#/$defs/ContentAddressedArtifactRef"
    },
    "randomization_spec_ref": {
      "$ref": "#/$defs/ContentAddressedArtifactRef"
    },
    "replay_class": {
      "$ref": "#/$defs/ReplayClass",
      "default": "TOLERANT"
    },
    "resource_budget": {
      "$ref": "#/$defs/ResourceBudget"
    },
    "retention_class": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retention Class"
    },
    "risk_class": {
      "const": "SIMULATION",
      "default": "SIMULATION",
      "title": "Risk Class",
      "type": "string"
    },
    "safety_envelope_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Safety Envelope Hash",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_set": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "minItems": 1,
      "title": "Seed Set",
      "type": "array"
    },
    "supersedes_contract_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Contract Id"
    },
    "tolerance_profile_ref": {
      "$ref": "#/$defs/ContentAddressedArtifactRef"
    },
    "verification_spec_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Verification Spec Hash",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    },
    "world_artifact_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "World Artifact Digest",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "created_by",
    "workspace_id",
    "objective_contract_ref",
    "node_contract_ref",
    "embodiment_ref",
    "adapter_ref",
    "world_artifact_digest",
    "controller_artifact_digest",
    "safety_envelope_hash",
    "verification_spec_hash",
    "seed_set",
    "randomization_spec_ref",
    "resource_budget",
    "tolerance_profile_ref",
    "protocol_ref"
  ],
  "title": "SimulationExperimentContract",
  "type": "object"
}
