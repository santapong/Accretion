{
  "$defs": {
    "ObjectiveContractRef": {
      "additionalProperties": false,
      "description": "SDD \u00a77.1. The exact objective revision a node was authorised against.\n\nThis is the type of the registry \u00a73 optional header field ``objective_contract_ref``,\nwhich is why it is defined before every other contract in this module and why\n:class:`~accretion.contracts.canonical.CanonicalContract` is rebuilt immediately below\nit.\n\n**Field coverage (SDD \u00a77.1 \u2192 here).** ``project_id`` \u2192 the header's ``project_id``.\n``objective_contract_id`` \u2192 ``objective_contract_id``. ``version`` \u2192 ``revision``, the\nregistry \u00a77.1 spelling, which is also what the ``ObjectiveContract`` aggregate calls its\nown counter. ``content_hash`` \u2192 ``objective_contract_hash``. ``verified_success_floor``,\n``utility_profile_id``, ``approved_at`` \u2192 unchanged. ``risk_policy_id`` \u2192 ``risk_policy``,\na typed :class:`~accretion.contracts.refs.PolicyRef` (registry \u00a73.1 requires policies to\nuse immutable typed references, and an authority decision audited against \"policy v3\" is\naudited against a label). ``approved_by`` \u2192 a typed\n:class:`~accretion.contracts.PrincipalRef` for the same reason.\n\n**Why the target's identity is qualified.** Registry \u00a73 describes the header field as\n``{contract_id, revision, content_hash}``, but inside a :class:`CanonicalContract` those\ntwo unqualified names already mean *this reference's own* id and digest. The target's\nare therefore spelled ``objective_contract_id`` and ``objective_contract_hash``. Nothing\nis lost and the ambiguity that would otherwise sit in every receipt is.\n\n``ID_KIND`` is ``None``: ADR-055 mints no prefix for a reference, because a reference is\ncreated and owned by the contract that embeds it and has no id space to collide in.\n``verified_success_floor`` is copied onto the reference rather than dereferenced because\n\u00a78.3 requires routing to run against an exact snapshot \u2014 a router that re-read the floor\nfrom the live objective would be routing against a number the receipt cannot prove.",
      "properties": {
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "approved_by": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "content_hash": {
          "default": "",
          "maxLength": 64,
          "title": "Content Hash",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        },
        "contract_type": {
          "const": "accretion.objective-contract-ref",
          "default": "accretion.objective-contract-ref",
          "title": "Contract Type",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "objective_contract_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Objective Contract Hash",
          "type": "string"
        },
        "objective_contract_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Objective Contract Id",
          "type": "string"
        },
        "objective_contract_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectiveContractRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "project_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "retention_class": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retention Class"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "risk_policy": {
          "$ref": "#/$defs/PolicyRef"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "supersedes_contract_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Contract Id"
        },
        "utility_profile_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Utility Profile Id",
          "type": "string"
        },
        "verified_success_floor": {
          "maximum": 1,
          "minimum": 0,
          "title": "Verified Success Floor",
          "type": "number"
        },
        "workspace_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "created_by",
        "workspace_id",
        "objective_contract_id",
        "revision",
        "objective_contract_hash",
        "verified_success_floor",
        "utility_profile_id",
        "risk_policy",
        "approved_by",
        "approved_at"
      ],
      "title": "ObjectiveContractRef",
      "type": "object"
    },
    "PolicyRef": {
      "additionalProperties": false,
      "description": "A policy by id, version and content digest (registry \u00a74).\n\nAuthority decisions are audited against the exact policy text that produced them, so the\ncontent digest is required: \"policy v3\" is a label, and labels are editable.",
      "properties": {
        "content_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "policy_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "version",
        "content_digest"
      ],
      "title": "PolicyRef",
      "type": "object"
    },
    "PrincipalRef": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "principal_id": {
          "title": "Principal Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PrincipalStatus"
        }
      },
      "required": [
        "principal_id",
        "status"
      ],
      "title": "PrincipalRef",
      "type": "object"
    },
    "PrincipalStatus": {
      "enum": [
        "ACTIVE",
        "DISABLED"
      ],
      "title": "PrincipalStatus",
      "type": "string"
    },
    "VerifierRef": {
      "additionalProperties": false,
      "description": "A verifier's contract plus the digest of the implementation that produced a result.\n\n``verifier_contract_id`` names the verifier *contract* \u2014 what is checked and what\ncounts as passing \u2014 and not a single v0.1 verification run. Registry \u00a719 requires that\nverification stay reproducible, which needs both halves: the contract explains what the\nverdict claimed, the implementation digest explains what code made the claim.",
      "properties": {
        "implementation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Implementation Digest",
          "type": "string"
        },
        "verifier_contract_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Verifier Contract Id",
          "type": "string"
        }
      },
      "required": [
        "verifier_contract_id",
        "implementation_digest"
      ],
      "title": "VerifierRef",
      "type": "object"
    },
    "VerifierRequirement": {
      "additionalProperties": false,
      "properties": {
        "deterministic": {
          "const": true,
          "default": true,
          "title": "Deterministic",
          "type": "boolean"
        },
        "independent": {
          "const": true,
          "default": true,
          "title": "Independent",
          "type": "boolean"
        },
        "required": {
          "const": true,
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "verifier": {
          "$ref": "#/$defs/VerifierRef"
        }
      },
      "required": [
        "verifier"
      ],
      "title": "VerifierRequirement",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "default": "",
      "maxLength": 64,
      "title": "Content Hash",
      "type": "string"
    },
    "contract_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Contract Id",
      "type": "string"
    },
    "contract_type": {
      "const": "accretion.embodied-verification-spec",
      "default": "accretion.embodied-verification-spec",
      "title": "Contract Type",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/PrincipalRef"
    },
    "evidence_completeness_verifier": {
      "$ref": "#/$defs/VerifierRequirement"
    },
    "inconclusive_policy": {
      "const": "HUMAN_REVIEW",
      "default": "HUMAN_REVIEW",
      "title": "Inconclusive Policy",
      "type": "string"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Labels",
      "type": "object"
    },
    "objective_contract_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectiveContractRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "optional_model_verifiers": {
      "items": {
        "$ref": "#/$defs/VerifierRef"
      },
      "title": "Optional Model Verifiers",
      "type": "array"
    },
    "project_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "reproducibility_verifier": {
      "$ref": "#/$defs/VerifierRequirement"
    },
    "retention_class": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retention Class"
    },
    "safety_verifiers": {
      "items": {
        "$ref": "#/$defs/VerifierRequirement"
      },
      "minItems": 1,
      "title": "Safety Verifiers",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "separate_identity_required": {
      "const": true,
      "default": true,
      "title": "Separate Identity Required",
      "type": "boolean"
    },
    "separate_process_required": {
      "const": true,
      "default": true,
      "title": "Separate Process Required",
      "type": "boolean"
    },
    "supersedes_contract_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Contract Id"
    },
    "task_verifiers": {
      "items": {
        "$ref": "#/$defs/VerifierRequirement"
      },
      "minItems": 1,
      "title": "Task Verifiers",
      "type": "array"
    },
    "workspace_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "created_by",
    "workspace_id",
    "task_verifiers",
    "safety_verifiers",
    "reproducibility_verifier",
    "evidence_completeness_verifier"
  ],
  "title": "EmbodiedVerificationSpec",
  "type": "object"
}
