{
  "$defs": {
    "ContentAddressedArtifactRef": {
      "additionalProperties": false,
      "description": "Run-independent blob identity; the URI is derived from its exact digest.\n\nThis does not weaken the existing run/path-based ArtifactRef. The artifact\nstore must enforce retention and byte limits when resolving this reference.",
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[^\\s/]+/[^\\s/]+$",
          "title": "Media Type",
          "type": "string"
        },
        "retention_class": {
          "enum": [
            "RUN",
            "PROJECT",
            "RESEARCH_ARCHIVE"
          ],
          "title": "Retention Class",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://sha256/[0-9a-f]{64}$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "digest",
        "media_type",
        "size_bytes",
        "retention_class",
        "evidence_class"
      ],
      "title": "ContentAddressedArtifactRef",
      "type": "object"
    },
    "ControllerMode": {
      "enum": [
        "JOINT_TRAJECTORY"
      ],
      "title": "ControllerMode",
      "type": "string"
    },
    "EvidenceClass": {
      "description": "How the world was observed. Names are pinned by the v0.4 cross-release registry.",
      "enum": [
        "DIGITAL",
        "SIMULATION",
        "PHYSICAL",
        "HUMAN_ATTESTATION",
        "EXTERNAL_SOURCE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "LeaseBinding": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "exclusiveMinimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "lease_id": {
          "pattern": "^sle_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Lease Id",
          "type": "string"
        }
      },
      "required": [
        "lease_id",
        "generation"
      ],
      "title": "LeaseBinding",
      "type": "object"
    },
    "ObjectiveContractRef": {
      "additionalProperties": false,
      "description": "SDD \u00a77.1. The exact objective revision a node was authorised against.\n\nThis is the type of the registry \u00a73 optional header field ``objective_contract_ref``,\nwhich is why it is defined before every other contract in this module and why\n:class:`~accretion.contracts.canonical.CanonicalContract` is rebuilt immediately below\nit.\n\n**Field coverage (SDD \u00a77.1 \u2192 here).** ``project_id`` \u2192 the header's ``project_id``.\n``objective_contract_id`` \u2192 ``objective_contract_id``. ``version`` \u2192 ``revision``, the\nregistry \u00a77.1 spelling, which is also what the ``ObjectiveContract`` aggregate calls its\nown counter. ``content_hash`` \u2192 ``objective_contract_hash``. ``verified_success_floor``,\n``utility_profile_id``, ``approved_at`` \u2192 unchanged. ``risk_policy_id`` \u2192 ``risk_policy``,\na typed :class:`~accretion.contracts.refs.PolicyRef` (registry \u00a73.1 requires policies to\nuse immutable typed references, and an authority decision audited against \"policy v3\" is\naudited against a label). ``approved_by`` \u2192 a typed\n:class:`~accretion.contracts.PrincipalRef` for the same reason.\n\n**Why the target's identity is qualified.** Registry \u00a73 describes the header field as\n``{contract_id, revision, content_hash}``, but inside a :class:`CanonicalContract` those\ntwo unqualified names already mean *this reference's own* id and digest. The target's\nare therefore spelled ``objective_contract_id`` and ``objective_contract_hash``. Nothing\nis lost and the ambiguity that would otherwise sit in every receipt is.\n\n``ID_KIND`` is ``None``: ADR-055 mints no prefix for a reference, because a reference is\ncreated and owned by the contract that embeds it and has no id space to collide in.\n``verified_success_floor`` is copied onto the reference rather than dereferenced because\n\u00a78.3 requires routing to run against an exact snapshot \u2014 a router that re-read the floor\nfrom the live objective would be routing against a number the receipt cannot prove.",
      "properties": {
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "approved_by": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "content_hash": {
          "default": "",
          "maxLength": 64,
          "title": "Content Hash",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        },
        "contract_type": {
          "const": "accretion.objective-contract-ref",
          "default": "accretion.objective-contract-ref",
          "title": "Contract Type",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "objective_contract_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Objective Contract Hash",
          "type": "string"
        },
        "objective_contract_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Objective Contract Id",
          "type": "string"
        },
        "objective_contract_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectiveContractRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "project_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "retention_class": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retention Class"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "risk_policy": {
          "$ref": "#/$defs/PolicyRef"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "supersedes_contract_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Contract Id"
        },
        "utility_profile_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Utility Profile Id",
          "type": "string"
        },
        "verified_success_floor": {
          "maximum": 1,
          "minimum": 0,
          "title": "Verified Success Floor",
          "type": "number"
        },
        "workspace_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "created_by",
        "workspace_id",
        "objective_contract_id",
        "revision",
        "objective_contract_hash",
        "verified_success_floor",
        "utility_profile_id",
        "risk_policy",
        "approved_by",
        "approved_at"
      ],
      "title": "ObjectiveContractRef",
      "type": "object"
    },
    "PolicyRef": {
      "additionalProperties": false,
      "description": "A policy by id, version and content digest (registry \u00a74).\n\nAuthority decisions are audited against the exact policy text that produced them, so the\ncontent digest is required: \"policy v3\" is a label, and labels are editable.",
      "properties": {
        "content_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "policy_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "version",
        "content_digest"
      ],
      "title": "PolicyRef",
      "type": "object"
    },
    "PreparedGripperCommand": {
      "additionalProperties": false,
      "properties": {
        "acceleration_m_s2": {
          "exclusiveMinimum": 0,
          "title": "Acceleration M S2",
          "type": "number"
        },
        "command_type": {
          "const": "GRIPPER_OPENING",
          "default": "GRIPPER_OPENING",
          "title": "Command Type",
          "type": "string"
        },
        "force_limit_n": {
          "exclusiveMinimum": 0,
          "title": "Force Limit N",
          "type": "number"
        },
        "opening_m": {
          "minimum": 0,
          "title": "Opening M",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "velocity_m_s": {
          "exclusiveMinimum": 0,
          "title": "Velocity M S",
          "type": "number"
        }
      },
      "required": [
        "opening_m",
        "velocity_m_s",
        "acceleration_m_s2",
        "force_limit_n"
      ],
      "title": "PreparedGripperCommand",
      "type": "object"
    },
    "PreparedTrajectory": {
      "additionalProperties": false,
      "description": "Arm-only normalized trajectory. Joint order must match the admitted descriptor.",
      "properties": {
        "command_type": {
          "const": "JOINT_TRAJECTORY",
          "default": "JOINT_TRAJECTORY",
          "title": "Command Type",
          "type": "string"
        },
        "joint_names": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[^\\s*]+$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Joint Names",
          "type": "array"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/TrajectoryPoint"
          },
          "maxItems": 10000,
          "minItems": 2,
          "title": "Points",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "joint_names",
        "points"
      ],
      "title": "PreparedTrajectory",
      "type": "object"
    },
    "PrincipalRef": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "principal_id": {
          "title": "Principal Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PrincipalStatus"
        }
      },
      "required": [
        "principal_id",
        "status"
      ],
      "title": "PrincipalRef",
      "type": "object"
    },
    "PrincipalStatus": {
      "enum": [
        "ACTIVE",
        "DISABLED"
      ],
      "title": "PrincipalStatus",
      "type": "string"
    },
    "StateBinding": {
      "additionalProperties": false,
      "properties": {
        "frame_transform_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Frame Transform Digest",
          "type": "string"
        },
        "observation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Digest",
          "type": "string"
        },
        "observation_sequence": {
          "minimum": 0,
          "title": "Observation Sequence",
          "type": "integer"
        },
        "sim_time_ns": {
          "minimum": 0,
          "title": "Sim Time Ns",
          "type": "integer"
        }
      },
      "required": [
        "observation_digest",
        "observation_sequence",
        "sim_time_ns",
        "frame_transform_digest"
      ],
      "title": "StateBinding",
      "type": "object"
    },
    "TrajectoryPoint": {
      "additionalProperties": false,
      "properties": {
        "accelerations_rad_s2": {
          "items": {
            "type": "number"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Accelerations Rad S2",
          "type": "array"
        },
        "effort_upper_bounds_nm": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Effort Upper Bounds Nm",
          "type": "array"
        },
        "positions_rad": {
          "items": {
            "type": "number"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Positions Rad",
          "type": "array"
        },
        "time_from_start_ns": {
          "minimum": 0,
          "title": "Time From Start Ns",
          "type": "integer"
        },
        "velocities_rad_s": {
          "items": {
            "type": "number"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Velocities Rad S",
          "type": "array"
        }
      },
      "required": [
        "time_from_start_ns",
        "positions_rad",
        "velocities_rad_s",
        "accelerations_rad_s2",
        "effort_upper_bounds_nm"
      ],
      "title": "TrajectoryPoint",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_intent_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Action Intent Hash",
      "type": "string"
    },
    "adapter_artifact_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Adapter Artifact Digest",
      "type": "string"
    },
    "command_payload": {
      "discriminator": {
        "mapping": {
          "GRIPPER_OPENING": "#/$defs/PreparedGripperCommand",
          "JOINT_TRAJECTORY": "#/$defs/PreparedTrajectory"
        },
        "propertyName": "command_type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PreparedTrajectory"
        },
        {
          "$ref": "#/$defs/PreparedGripperCommand"
        }
      ],
      "title": "Command Payload"
    },
    "command_ref": {
      "$ref": "#/$defs/ContentAddressedArtifactRef"
    },
    "command_schema_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Command Schema Hash",
      "type": "string"
    },
    "content_hash": {
      "default": "",
      "maxLength": 64,
      "title": "Content Hash",
      "type": "string"
    },
    "contract_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Contract Id",
      "type": "string"
    },
    "contract_type": {
      "const": "accretion.prepared-command",
      "default": "accretion.prepared-command",
      "title": "Contract Type",
      "type": "string"
    },
    "controller_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Controller Digest",
      "type": "string"
    },
    "controller_mode": {
      "$ref": "#/$defs/ControllerMode"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/PrincipalRef"
    },
    "episode_id": {
      "pattern": "^sep_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Episode Id",
      "type": "string"
    },
    "expires_at_sim_time_ns": {
      "minimum": 0,
      "title": "Expires At Sim Time Ns",
      "type": "integer"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Labels",
      "type": "object"
    },
    "lease": {
      "$ref": "#/$defs/LeaseBinding"
    },
    "objective_contract_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectiveContractRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "project_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "retention_class": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retention Class"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/StateBinding"
    },
    "supersedes_contract_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Contract Id"
    },
    "workspace_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "created_by",
    "workspace_id",
    "episode_id",
    "action_intent_hash",
    "sequence",
    "state",
    "lease",
    "controller_mode",
    "command_ref",
    "command_payload",
    "command_schema_hash",
    "controller_digest",
    "adapter_artifact_digest",
    "expires_at_sim_time_ns"
  ],
  "title": "PreparedCommand",
  "type": "object"
}
