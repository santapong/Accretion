{
  "$defs": {
    "ObjectiveContractRef": {
      "additionalProperties": false,
      "description": "SDD \u00a77.1. The exact objective revision a node was authorised against.\n\nThis is the type of the registry \u00a73 optional header field ``objective_contract_ref``,\nwhich is why it is defined before every other contract in this module and why\n:class:`~accretion.contracts.canonical.CanonicalContract` is rebuilt immediately below\nit.\n\n**Field coverage (SDD \u00a77.1 \u2192 here).** ``project_id`` \u2192 the header's ``project_id``.\n``objective_contract_id`` \u2192 ``objective_contract_id``. ``version`` \u2192 ``revision``, the\nregistry \u00a77.1 spelling, which is also what the ``ObjectiveContract`` aggregate calls its\nown counter. ``content_hash`` \u2192 ``objective_contract_hash``. ``verified_success_floor``,\n``utility_profile_id``, ``approved_at`` \u2192 unchanged. ``risk_policy_id`` \u2192 ``risk_policy``,\na typed :class:`~accretion.contracts.refs.PolicyRef` (registry \u00a73.1 requires policies to\nuse immutable typed references, and an authority decision audited against \"policy v3\" is\naudited against a label). ``approved_by`` \u2192 a typed\n:class:`~accretion.contracts.PrincipalRef` for the same reason.\n\n**Why the target's identity is qualified.** Registry \u00a73 describes the header field as\n``{contract_id, revision, content_hash}``, but inside a :class:`CanonicalContract` those\ntwo unqualified names already mean *this reference's own* id and digest. The target's\nare therefore spelled ``objective_contract_id`` and ``objective_contract_hash``. Nothing\nis lost and the ambiguity that would otherwise sit in every receipt is.\n\n``ID_KIND`` is ``None``: ADR-055 mints no prefix for a reference, because a reference is\ncreated and owned by the contract that embeds it and has no id space to collide in.\n``verified_success_floor`` is copied onto the reference rather than dereferenced because\n\u00a78.3 requires routing to run against an exact snapshot \u2014 a router that re-read the floor\nfrom the live objective would be routing against a number the receipt cannot prove.",
      "properties": {
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "approved_by": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "content_hash": {
          "default": "",
          "maxLength": 64,
          "title": "Content Hash",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        },
        "contract_type": {
          "const": "accretion.objective-contract-ref",
          "default": "accretion.objective-contract-ref",
          "title": "Contract Type",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "objective_contract_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Objective Contract Hash",
          "type": "string"
        },
        "objective_contract_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Objective Contract Id",
          "type": "string"
        },
        "objective_contract_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectiveContractRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "project_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "retention_class": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retention Class"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "risk_policy": {
          "$ref": "#/$defs/PolicyRef"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "supersedes_contract_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Contract Id"
        },
        "utility_profile_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Utility Profile Id",
          "type": "string"
        },
        "verified_success_floor": {
          "maximum": 1,
          "minimum": 0,
          "title": "Verified Success Floor",
          "type": "number"
        },
        "workspace_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "created_by",
        "workspace_id",
        "objective_contract_id",
        "revision",
        "objective_contract_hash",
        "verified_success_floor",
        "utility_profile_id",
        "risk_policy",
        "approved_by",
        "approved_at"
      ],
      "title": "ObjectiveContractRef",
      "type": "object"
    },
    "PolicyRef": {
      "additionalProperties": false,
      "description": "A policy by id, version and content digest (registry \u00a74).\n\nAuthority decisions are audited against the exact policy text that produced them, so the\ncontent digest is required: \"policy v3\" is a label, and labels are editable.",
      "properties": {
        "content_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "policy_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "version",
        "content_digest"
      ],
      "title": "PolicyRef",
      "type": "object"
    },
    "PrincipalRef": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "principal_id": {
          "title": "Principal Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PrincipalStatus"
        }
      },
      "required": [
        "principal_id",
        "status"
      ],
      "title": "PrincipalRef",
      "type": "object"
    },
    "PrincipalStatus": {
      "enum": [
        "ACTIVE",
        "DISABLED"
      ],
      "title": "PrincipalStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "SDD \u00a711.4 and the \u00a713 ``shadow_decisions`` table: what a candidate router *would* have done.\n\nADR-046 stages v0.4 as offline, then shadow, then guarded bandit, and this is the shadow\nstage's unit of evidence: for one executed decision, the decision a candidate router\nproduced without being allowed to act on it. Nothing here dispatches; a shadow decision\nthat could affect execution would not be a shadow.\n\n**Field coverage.** SDD \u00a77 gives this record no schema \u2014 \u00a711.4 defines the endpoints and\n\u00a713 names the table's key fields as \"executed receipt, shadow receipt, comparison\" \u2014 so\nthe shape is owned by this freeze. ``executed_receipt_id`` and ``shadow_receipt_id`` are\nthe two receipts; ``shadow_router_version_id`` names the candidate that produced the\nsecond one, without which a batch of shadow decisions could not be attributed to a\nmodel; the two configuration hashes and ``agreement`` are the comparison; and\n``projected_utility_delta`` is what \u00a710.2's \"shadow-decision agreement and projected\nutility\" evaluation aggregates.\n\n``agreement`` is stored rather than derived, and then checked against the hashes it\nclaims to summarise. Storing it makes the common query cheap; checking it means the\nstored value cannot drift from the two digests beside it, which is the only way a\nsummary field in a frozen contract is safe.",
  "properties": {
    "agreement": {
      "title": "Agreement",
      "type": "boolean"
    },
    "comparison_notes": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Comparison Notes",
      "type": "string"
    },
    "content_hash": {
      "default": "",
      "maxLength": 64,
      "title": "Content Hash",
      "type": "string"
    },
    "contract_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Contract Id",
      "type": "string"
    },
    "contract_type": {
      "const": "accretion.shadow-decision",
      "default": "accretion.shadow-decision",
      "title": "Contract Type",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/PrincipalRef"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "executed_configuration_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executed Configuration Hash"
    },
    "executed_receipt_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Executed Receipt Id",
      "type": "string"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Labels",
      "type": "object"
    },
    "objective_contract_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectiveContractRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "project_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "projected_utility_delta": {
      "title": "Projected Utility Delta",
      "type": "number"
    },
    "retention_class": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retention Class"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "shadow_configuration_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shadow Configuration Hash"
    },
    "shadow_receipt_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Shadow Receipt Id",
      "type": "string"
    },
    "shadow_router_version_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Shadow Router Version Id",
      "type": "string"
    },
    "supersedes_contract_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Contract Id"
    },
    "workspace_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "created_by",
    "workspace_id",
    "executed_receipt_id",
    "shadow_receipt_id",
    "shadow_router_version_id",
    "agreement",
    "projected_utility_delta",
    "comparison_notes",
    "evaluated_at"
  ],
  "title": "ShadowDecision",
  "type": "object"
}
