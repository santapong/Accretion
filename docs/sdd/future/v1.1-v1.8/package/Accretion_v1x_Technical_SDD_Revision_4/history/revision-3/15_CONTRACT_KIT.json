{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accretion document revision 3 extension payload and projection kit",
  "description": "Synthetic design conformance only; inherited owner envelopes/references/signatures are validated separately at integration. Payload schema_version is independent of document revision.",
  "$defs": {
    "Locator": {
      "type": "object",
      "properties": {
        "contract_type": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "contract_type",
        "record_id",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "EvaluationProtocol": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "protocol_id": {
          "type": "string",
          "minLength": 1
        },
        "fixture_only": {
          "type": "boolean"
        },
        "horizon_ms": {
          "type": "integer",
          "minimum": 1
        },
        "success_floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "noninferiority_margin": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "minimum_effect_ms": {
          "type": "integer",
          "minimum": 1
        },
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "exclusiveMaximum": 1
        },
        "maximum_missing_fraction": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "cohorts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "budget_manifest_ref": {
          "$ref": "#/$defs/Locator"
        },
        "sample_size_plan_ref": {
          "$ref": "#/$defs/Locator"
        },
        "analysis_plan_ref": {
          "$ref": "#/$defs/Locator"
        },
        "stopping_rule_ref": {
          "$ref": "#/$defs/Locator"
        },
        "baseline_manifest_ref": {
          "$ref": "#/$defs/Locator"
        },
        "split_manifest_ref": {
          "$ref": "#/$defs/Locator"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "protocol_id",
        "fixture_only",
        "horizon_ms",
        "success_floor",
        "noninferiority_margin",
        "minimum_effect_ms",
        "confidence_level",
        "maximum_missing_fraction",
        "cohorts",
        "budget_manifest_ref",
        "sample_size_plan_ref",
        "analysis_plan_ref",
        "stopping_rule_ref",
        "baseline_manifest_ref",
        "split_manifest_ref",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "ComputeDecisionPayload": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "BASELINE",
            "SHADOW",
            "EXPLOIT",
            "EXPLORE",
            "ABSTAIN"
          ]
        },
        "node_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "properties": {
                "contract_type": {
                  "const": "NodeContract"
                }
              }
            }
          ]
        },
        "verification_spec_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "properties": {
                "contract_type": {
                  "const": "VerificationSpec"
                }
              }
            }
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/Locator"
              },
              {
                "properties": {
                  "contract_type": {
                    "const": "ComputeProfile"
                  }
                }
              }
            ]
          }
        },
        "candidate_set_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selected_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Locator"
                },
                {
                  "properties": {
                    "contract_type": {
                      "const": "ComputeProfile"
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "fallback_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Locator"
                },
                {
                  "properties": {
                    "contract_type": {
                      "const": "ComputeProfile"
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "abstention_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection_probability": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "decision_id",
        "mode",
        "node_ref",
        "verification_spec_ref",
        "candidates",
        "candidate_set_hash",
        "selected_ref",
        "fallback_ref",
        "abstention_reason",
        "policy_artifact_ref",
        "selection_probability",
        "content_hash"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "ABSTAIN"
              }
            }
          },
          "then": {
            "properties": {
              "selected_ref": {
                "type": "null"
              },
              "abstention_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "selected_ref": {
                "$ref": "#/$defs/Locator"
              },
              "abstention_reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
