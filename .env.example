ACCRETION_ENVIRONMENT=development
ACCRETION_DATABASE_URL=postgresql+asyncpg://accretion:accretion@localhost:5432/accretion
ACCRETION_DATA_DIR=.accretion
ACCRETION_CORS_ORIGINS=["http://localhost:5173"]
ACCRETION_GLOBAL_MAX_RUNS=4
ACCRETION_PROVIDER_MAX_RUNS=2
ACCRETION_PROJECT_MAX_RUNS=2
ACCRETION_CODEX_COMMAND=codex
ACCRETION_CLAUDE_COMMAND=claude
ACCRETION_OPENCODE_COMMAND=opencode
# providerID/modelID. Free preview models are withdrawn without notice; when that
# happens the runtime reports DEGRADED and this is the only line that needs changing.
ACCRETION_OPENCODE_MODEL=opencode/x-preview-f-free
ACCRETION_ENABLE_LIVE_PROVIDERS=false
ACCRETION_ENABLE_DYNAMIC_WORKFLOWS=false
ACCRETION_ENABLE_CANDIDATE_SEARCH=false
ACCRETION_ENABLE_EXPERIENCE_RETRIEVAL=false
# Opt-in deterministic receipt-first graph routing; shipped catalog is FAKE-only.
ACCRETION_ENABLE_NODE_ROUTING=false
ACCRETION_OPERATOR_IDENTITY=local-operator
ACCRETION_CAPABILITY_POLICY_ID=local-capability-policy
ACCRETION_GRANTED_PERMISSIONS=[]
ACCRETION_CREDENTIAL_ENV_MAP={}
# Token broker master key: base64 of 32 random bytes, stored outside PostgreSQL.
# Generate with: uv run python -c \
#   "from accretion.secrets_store import generate_master_key; print(generate_master_key())"
# Rotating this key makes every stored credential unopenable; re-authorize afterwards.
ACCRETION_TOKEN_ENCRYPTION_KEY=
# GitHub OAuth app. Enable "expiring user tokens" on the app, or GitHub issues no
# refresh token and the refresh lifecycle cannot run.
ACCRETION_GITHUB_CLIENT_ID=
ACCRETION_GITHUB_CLIENT_SECRET=
# Identity (v0.3 M1). LOCAL_PRINCIPAL needs no provider; OIDC needs the three keys.
ACCRETION_AUTH_MODE=LOCAL_PRINCIPAL
ACCRETION_OIDC_ISSUER=
ACCRETION_OIDC_CLIENT_ID=
ACCRETION_OIDC_CLIENT_SECRET=
ACCRETION_OIDC_REDIRECT_URL=http://localhost:8000/api/v1/auth/callback
ACCRETION_OIDC_SCOPES="openid profile email"
ACCRETION_SESSION_COOKIE_NAME=accretion_session
ACCRETION_SESSION_TTL_SECONDS=28800
# Remote MCP endpoint policy (v0.3 M3). Empty hosts = any public HTTPS host;
# glob patterns are accepted (["*.example.com"]). Ports default to 443.
# ALLOW_LOCAL_HTTP admits plain-http loopback servers for development only.
ACCRETION_MCP_ALLOWED_HOSTS=[]
ACCRETION_MCP_ALLOWED_PORTS=[443]
ACCRETION_MCP_ALLOW_LOCAL_HTTP=false
# Plugin trust (v0.3 M4). TRUSTED_KEYS maps a key id to "[<TRUST_LEVEL>:]<base64 32-byte
# Ed25519 public key>"; the level defaults to SIGNED_THIRD_PARTY and may only be
# WORKSPACE_APPROVED or SIGNED_THIRD_PARTY. Unsigned packages install only when
# ALLOW_UNVERIFIED_DEV is true, and never above the trust their risk level demands.
ACCRETION_PLUGIN_TRUSTED_KEYS={}
ACCRETION_PLUGIN_ALLOW_UNVERIFIED_DEV=false
ACCRETION_PLUGIN_BUILTIN_IDS=["accretion-core-governance","accretion-sample-plugin","accretion-research"]
# Research intelligence (v0.3 M5). ENABLE_RESEARCH_PLUGIN alone opens nothing:
# the adapter may reach only hosts listed in RESEARCH_ALLOWED_HOSTS, and an empty
# list means no upstream egress at all. CONNECTOR_ID names the connector the
# workflow binds to; swapping it must never change a workflow capability id.
ACCRETION_ENABLE_RESEARCH_PLUGIN=false
ACCRETION_RESEARCH_CONNECTOR_ID=research-openalex
ACCRETION_RESEARCH_MAX_RESULTS=25
ACCRETION_RESEARCH_ALLOWED_HOSTS=[]
# Enterprise-managed authorization (v0.3 M7, SDD 8 / OQ3-08). Optional and off by
# default. ENABLE_ENTERPRISE_AUTH alone opens nothing: without a TOKEN_EXCHANGE_URL
# the subsystem is inert, and a connector absent from AUDIENCES cannot be
# enterprise-authorized. AUDIENCES maps connector_id -> the audience the identity
# provider must issue the ID-JAG for.
ACCRETION_ENABLE_ENTERPRISE_AUTH=false
ACCRETION_ENTERPRISE_AUTH_TOKEN_EXCHANGE_URL=
ACCRETION_ENTERPRISE_AUTH_AUDIENCES={}
