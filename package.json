{
  "name": "accretion",
  "private": true,
  "version": "0.4.1",
  "workspaces": ["apps/*"],
  "devDependencies": {
    "vite": "^8.2.1"
  },
  "overrides": {
    "@redocly/openapi-core@1.34.19": {
      "js-yaml": "4.3.2"
    }
  },
  "scripts": {
    "api:generate": "uv run --no-sync python scripts/export_openapi.py && npm exec --workspace @accretion/ui -- openapi-typescript ../../openapi.json -o src/api/schema.d.ts",
    "build": "npm run build --workspace @accretion/ui",
    "check": "npm run check --workspace @accretion/ui",
    "test": "npm run test --workspace @accretion/ui"
  }
}
